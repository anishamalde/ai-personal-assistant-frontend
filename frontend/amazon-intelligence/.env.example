# AWS Configuration - Use EXPO_PUBLIC_ prefix for all variables used in client code
EXPO_PUBLIC_AWS_REGION=us-west-2
EXPO_PUBLIC_COGNITO_USER_POOL_ID=us-west-2_yourUserPoolId
EXPO_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=yourUserPoolClientId
EXPO_PUBLIC_COGNITO_IDENTITY_POOL_ID=us-west-2:yourIdentityPoolId
EXPO_PUBLIC_S3_BUCKET=your-s3-bucket-name
EXPO_PUBLIC_API_ENDPOINT=https://your-api-id.execute-api.region.amazonaws.com/stage/
